# Copy to .env and fill in. NEVER commit .env to Git.

# Your domain (its DNS A record must point to this server's IP)
DOMAIN=queueup.example.com

# Database
DB_USERNAME=queueup_app
DB_PASSWORD=change-me-long-random
MYSQL_ROOT_PASSWORD=change-me-different-long-random

# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me

# Email for password resets (example: Brevo SMTP). Leave SPRING_MAIL_HOST empty to only log emails.
MAIL_FROM=no-reply@queueup.example.com
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Delete finished customer records after this many days
RETENTION_DAYS=90
